# Claude via AWS Bedrock
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=arn:aws:bedrock:us-east-1:<account>:inference-profile/global.anthropic.claude-haiku-4-5-20251001-v1:0

# Tavily web search (https://app.tavily.com)
TAVILY_API_KEY=

# MongoDB. Leave unset to use an in-memory store.
MONGODB_URI=
MONGODB_DB=paypal_shopping_agent
# Set after running scripts/create_vector_index.py on Atlas
MONGODB_VECTOR_INDEX=

# PayPal checkout: REST app credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Deals priced in this currency can be paid in the app; others link out to the store.
PAYPAL_CURRENCY=USD
# Stores the app pays directly (their PayPal account is the payee). Copy merchants.example.json.
MERCHANTS_FILE=merchants.json

# Gmail, so the payment agent can find the store's receipt and email the store if none arrives.
# OAuth client ("Web application") at https://console.cloud.google.com/apis/credentials,
# with GOOGLE_REDIRECT_URI as an authorised redirect URI and the Gmail API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback
# Signs the Gmail sign-in state. Any long random string.
APP_SECRET=

# Web Push: python -m scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Payment agent: hours to wait for a receipt before emailing the store, and seconds between checks
RECEIPT_WAIT_HOURS=24
RECEIPT_POLL_SECONDS=300

# Optional: direct Anthropic API (claude_api.py)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
